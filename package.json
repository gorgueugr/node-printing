{
  "name": "printing",
  "version": "2.0.0",
  "description": "Manage printers and print jobs from Node.js: list queues, inspect and control jobs, print raw data, files and documents. Windows (Winspool) and Linux/macOS (CUPS).",
  "type": "module",
  "main": "index.cjs",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "gypfile": true,
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "lib/",
    "src/",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node-gyp clean",
    "configure": "node-gyp configure",
    "build": "node-gyp build",
    "rebuild": "node-gyp rebuild",
    "install": "node-gyp rebuild",
    "test": "node test/smoke.cjs && node test/api.cjs",
    "test:smoke": "node test/smoke.cjs",
    "test:api": "node test/api.cjs",
    "test:e2e": "bash test/docker/e2e-cups.sh",
    "example": "node examples/list-printers.cjs"
  },
  "keywords": [
    "printer",
    "print",
    "printing",
    "printers",
    "print-job",
    "spooler",
    "cups",
    "ipp",
    "winspool",
    "native-addon",
    "napi"
  ],
  "author": "Jorge Soler <gorgueugr@gmail.com>",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "dependencies": {
    "node-addon-api": "^8.3.0"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0"
  }
}
